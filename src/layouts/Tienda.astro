---
/**
 * Layout de la tienda: lo que se repite en todas las paginas.
 *
 * Encabezado, barra de categorias, pie y panel del carrito. El contenido de
 * cada pagina entra por el <slot />, y su texto vive en src/datos/.
 */
import "../styles/global.css";
import "../styles/tienda.css";
import config from "../datos/config.json";
import Header from "../components/Header.astro";
import SubnavCategorias from "../components/SubnavCategorias.astro";
import Footer from "../components/Footer.astro";
import VentanaOferta from "../components/VentanaOferta.astro";
import Icono from "../components/Icono.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
  imagen?: string;
  sinSubnav?: boolean;
}

const {
  titulo,
  descripcion = config.descripcion_corta,
  activa = "",
  imagen,
  sinSubnav = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const tituloCompleto = titulo.includes(config.negocio) ? titulo : `${titulo} | ${config.negocio}`;
const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
const imagenSocial = new URL(imagen ?? `${base}img/compartir-xivica.png`, urlCanonica);

// Ficha del negocio para Google. Las sedes van como sucursales.
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "Pharmacy",
  name: config.negocio,
  description: config.descripcion_corta,
  telephone: `+${config.whatsapp}`,
  address: config.sedes.map((sede) => ({
    "@type": "PostalAddress",
    streetAddress: sede.direccion,
    addressLocality: config.ciudad,
    addressCountry: "CO",
  })),
  geo: config.sedes.map((sede) => ({
    "@type": "GeoCoordinates",
    latitude: sede.lat,
    longitude: sede.lng,
  })),
};
---

<!doctype html>
<html lang="es" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#00aafa" />
    <link rel="canonical" href={urlCanonica.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}img/isotipo-xivica.svg`} />
    <link rel="apple-touch-icon" href={`${base}img/isotipo-xivica-180.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.negocio} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial.href} />
    <meta property="og:url" content={urlCanonica.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <!-- Medición: cada bloque sale solo si el propietario entregó ese código.
         Con los campos vacíos no se carga nada de terceros. -->
    {config.medicion?.google_analytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${config.medicion.google_analytics}`}></script>
        <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${config.medicion.google_analytics}');`} />
      </>
    )}
    {config.medicion?.meta_pixel && (
      <>
        <script set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${config.medicion.meta_pixel}');fbq('track','PageView');`} />
        <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${config.medicion.meta_pixel}&ev=PageView&noscript=1`} /></noscript>
      </>
    )}
    {config.medicion?.metricool && (
      <script set:html={`function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"${config.medicion.metricool}"})});`} />
    )}
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <Header />
    {!sinSubnav && <SubnavCategorias activa={activa} />}

    <main id="contenido">
      <slot />
    </main>

    <Footer />

    <!-- Ventana emergente de oferta: solo aparece cuando el propietario deja una oferta activa. -->
    <VentanaOferta />

    <!-- Panel del carrito. Vive en el layout para que este disponible en toda pagina. -->
    <div class="carrito-fondo" id="carritoFondo" hidden></div>
    <aside
      class="carrito"
      id="carrito"
      aria-label="Carrito de compras"
      aria-hidden="true"
      data-whatsapp={config.whatsapp}
      data-envio={config.envio.gratis_desde}
      data-sedes={JSON.stringify(config.sedes.map((sede) => ({ id: sede.id, nombre: sede.nombre, telefono: sede.telefono })))}
      hidden
    >
      <header class="carrito-cabeza">
        <h2>Tu pedido</h2>
        <button type="button" id="cerrarCarrito" class="carrito-cerrar" aria-label="Cerrar carrito">
          <Icono nombre="cerrar" tamano={20} />
        </button>
      </header>
      <div class="carrito-cuerpo" id="carritoCuerpo"></div>
    </aside>

    <!-- Barra de pago, solo aparece con el carrito lleno -->
    <div class="barra-pago" id="barraPago" hidden>
      <span class="barra-pago-texto">
        <strong id="barraPagoTotal">$0</strong>
        <small id="barraPagoItems">0 productos</small>
      </span>
      <button type="button" class="boton boton-lima" id="barraPagoBoton">Finalizar pedido</button>
    </div>

    <a
      class="flota-wa"
      href={`https://wa.me/${config.whatsapp}`}
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <Icono nombre="whatsapp" tamano={26} />
    </a>

    <script>
      import "../scripts/tienda.js";
    </script>
  </body>
</html>
