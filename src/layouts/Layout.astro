---
/**
 * Layout base — lo que se repite en todas las páginas.
 * Menú, pie, botón de tema, aparición al bajar, volver arriba.
 *
 * El contenido de cada página NO se escribe aquí: vive en src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
}
const { titulo, descripcion = sitio.descripcion, activa = "" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/brand/favicon.png" />

    <!-- Redes sociales -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />

    <!--
      Evita el parpadeo de tema incorrecto.
      Va ANTES de que se pinte nada: si se mueve más abajo, el visitante
      ve un destello blanco al entrar con tema oscuro.
    -->
    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        try {
          document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem(clave) || "light"
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <!-- ==================== MENÚ ==================== -->
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo">
          <img src="/brand/logo.png" alt={sitio.nombre} />
        </a>

        <nav class="nav-links" id="navLinks">
          {sitio.menu.map((item) => (
            <a href={item.href} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
          ))}
        </nav>

        <div class="nav-actions">
          <button id="botonTema" aria-label="Cambiar entre tema claro y oscuro"></button>
          <a href={sitio.ctaPrincipal.href} class="btn btn-primary">{sitio.ctaPrincipal.texto}</a>
          <button id="botonMenu" aria-label="Abrir menú" aria-expanded="false"></button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ==================== PIE ==================== -->
    <footer class="pie">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} {sitio.razonSocial}. Todos los derechos reservados.</p>
        <nav class="pie-legales">
          {sitio.legales.map((l) => <a href={l.href}>{l.texto}</a>)}
        </nav>
      </div>
    </footer>

    <a
      href={`https://wa.me/${sitio.whatsapp}`}
      class="flota-wa"
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <i data-lucide="message-circle"></i>
    </a>
    <button class="volver-arriba" id="volverArriba" aria-label="Volver arriba">
      <i data-lucide="arrow-up"></i>
    </button>

    <!--
      Librerías guardadas dentro del sitio, no desde servidores ajenos.
      Privacidad + longevidad. Ver conocimiento/politicas.md.
    -->
    <script is:inline src="/vendor/lucide/lucide.min.js"></script>
    <script is:inline src="/vendor/gsap/gsap.min.js"></script>
    <script is:inline src="/vendor/gsap/ScrollTrigger.min.js"></script>

    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const raiz = document.documentElement;
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (window.lucide) lucide.createIcons();

      /* ---------- Tema claro / oscuro ---------- */
      const botonTema = $("#botonTema");
      const pintarBotonTema = () => {
        botonTema.innerHTML =
          raiz.getAttribute("data-theme") === "dark"
            ? '<i data-lucide="sun"></i>'
            : '<i data-lucide="moon"></i>';
        if (window.lucide) lucide.createIcons();
      };
      botonTema?.addEventListener("click", () => {
        const siguiente = raiz.getAttribute("data-theme") === "dark" ? "light" : "dark";
        raiz.setAttribute("data-theme", siguiente);
        try { localStorage.setItem(clave, siguiente); } catch (e) {}
        pintarBotonTema();
      });
      pintarBotonTema();

      /* ---------- Menú en celular ---------- */
      const botonMenu = $("#botonMenu");
      botonMenu?.addEventListener("click", () => {
        const abierto = $("#navLinks").classList.toggle("abierto");
        botonMenu.setAttribute("aria-expanded", String(abierto));
      });

      /* ---------- Apariciones al bajar, con GSAP ---------- */
      if (window.gsap && window.ScrollTrigger && !menosMovimiento) {
        gsap.registerPlugin(ScrollTrigger);
        $$(".reveal").forEach((el) =>
          gsap.to(el, {
            opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 88%" },
          })
        );
        // Parallax suave: data-parallax="0.08" (valores altos marean)
        $$("[data-parallax]").forEach((el) => {
          gsap.to(el, {
            yPercent: -parseFloat(el.dataset.parallax) * 100, ease: "none",
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
          });
        });
      } else {
        // Sin GSAP o con movimiento reducido: mostrar todo de una vez.
        $$(".reveal").forEach((el) => { el.style.opacity = 1; el.style.transform = "none"; });
      }

      /* ---------- Apariciones en CSS puro ---------- */
      const apariciones = $$(".reveal-up, .reveal-left, .reveal-right, .reveal-pop");
      // Retraso escalonado dentro de un grupo con data-stagger
      $$("[data-stagger]").forEach((grupo) => {
        Array.from(grupo.children).forEach((hijo, i) => hijo.style.setProperty("--i", i));
      });

      if (menosMovimiento || !("IntersectionObserver" in window)) {
        apariciones.forEach((el) => el.classList.add("seen"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("seen");
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
        );
        apariciones.forEach((el) => observador.observe(el));
      }

      /* ---------- Menú con fondo al bajar + volver arriba ---------- */
      const nav = $("#nav");
      const volverArriba = $("#volverArriba");
      const alBajar = () => {
        nav.classList.toggle("bajado", window.scrollY > 20);
        volverArriba.classList.toggle("visible", window.scrollY > 600);
      };
      window.addEventListener("scroll", alBajar, { passive: true });
      alBajar();
      volverArriba?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: menosMovimiento ? "auto" : "smooth" })
      );
    </script>
  </body>
</html>
