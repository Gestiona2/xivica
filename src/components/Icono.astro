---
/**
 * Iconos en SVG dibujados dentro del HTML.
 *
 * Van con `currentColor` a proposito: heredan el color del texto que los rodea,
 * asi que el dia que cambie la paleta no hay que tocar ni un icono. Tampoco se
 * carga ninguna libreria de iconos: son unos cuantos trazos y bajar 300 KB para
 * esto seria un mal negocio.
 *
 *   <Icono nombre="carrito" />
 *   <Icono nombre="buscar" tamano={20} />
 */
interface Props {
  nombre: string;
  tamano?: number;
  grosor?: number;
  clase?: string;
}
const { nombre, tamano = 20, grosor = 1.9, clase = "" } = Astro.props;

const TRAZOS: Record<string, string> = {
  buscar: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  carrito:
    '<path d="M5.5 6h15l-1.7 9.2a2 2 0 0 1-2 1.6H9.2a2 2 0 0 1-2-1.6L5.5 6Z"/>' +
    '<path d="M5.5 6 4.8 3H2"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="17.5" cy="20" r="1.4"/>',
  corazon:
    '<path d="M12 20.3s-7.2-4.6-7.2-9.6a4 4 0 0 1 7.2-2.4 4 4 0 0 1 7.2 2.4c0 5-7.2 9.6-7.2 9.6Z"/>',
  ubicacion: '<path d="M12 21.5s7-5.7 7-11.2a7 7 0 1 0-14 0c0 5.5 7 11.2 7 11.2Z"/><circle cx="12" cy="10" r="2.6"/>',
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  camion:
    '<path d="M2 7.5h11v9H2z"/><path d="M13 10.5h4l3 3v3h-7z"/>' +
    '<circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>',
  receta:
    '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9.5 11.5h5"/><path d="M9.5 15h5"/>',
  tienda:
    '<path d="M4 9.5V20h16V9.5"/><path d="M3 4h18l1 5.5a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0L3 4Z"/>',
  whatsapp:
    '<path d="M20.5 11.6a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.6-4.5a8.4 8.4 0 1 1 15.4-4.4Z"/>' +
    '<path d="M8.9 9c.3-.7.6-.7.9-.7h.7c.2 0 .5 0 .7.6l.8 1.9c.1.2 0 .4-.1.6l-.5.6c-.2.2-.3.4-.1.7a7 7 0 0 0 3 2.6c.3.1.5.1.7-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.3.4.5a2 2 0 0 1-1.4 1.9c-.7.2-1.7.3-4-1a11 11 0 0 1-4.3-4.6C8.3 10.9 8.6 9.7 8.9 9Z"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  menos: '<path d="M5 12h14"/>',
  basura: '<path d="M4 7h16"/><path d="M9 7V4.5h6V7"/><path d="M6 7l1 13h10l1-13"/>',
  cerrar: '<path d="m6 6 12 12M18 6 6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  flecha: '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  chevron: '<path d="m9 6 6 6-6 6"/>',
  chevronAbajo: '<path d="m6 9 6 6 6-6"/>',
  filtro: '<path d="M4 6h16M7 12h10M10 18h4"/>',
  escudo: '<path d="M12 3 5 6v5.5c0 4 3 7.7 7 9.5 4-1.8 7-5.5 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  rayo: '<path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/>',
  historial: '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3 4v4h4"/><path d="M12 7.5V12l3 1.8"/>',
  telefono:
    '<path d="M5 3.5h3.2l1.6 4-2 1.4a12 12 0 0 0 5.3 5.3l1.4-2 4 1.6V17a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.7 2 2 0 0 1 5 3.5Z"/>',
};

const trazo = TRAZOS[nombre] ?? "";
if (!trazo && import.meta.env.DEV) {
  console.warn(`[Icono] no existe "${nombre}". Iconos: ${Object.keys(TRAZOS).join(", ")}`);
}
---

<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={grosor}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={clase}
  aria-hidden="true"
  set:html={trazo}
/>
