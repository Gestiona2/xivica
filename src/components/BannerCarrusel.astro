---
/**
 * Carrusel de la portada. Tres piezas que rotan solas cada seis segundos, y
 * se detienen con el raton encima o al enfocar con el teclado.
 *
 * La primera pieza es la marca, no una promocion: el manual (cap. 50) pide que
 * el inicio diga que es Xivica y que beneficio ofrece.
 *
 * El arte se construye con los recursos graficos del manual (cap. 30): el
 * circulo y la curva amarilla del logo. Si la pieza tiene "foto" en
 * src/datos/home.json, la foto entra dentro de un circulo con aro amarillo (el
 * manual permite usar el circulo como marco o mascara, cap. 30) y reemplaza al
 * isotipo. Sin foto, la pieza muestra el isotipo o un icono.
 *
 * La foto va FUERA del contenedor del arte a proposito: ese contenedor se
 * atenua en celular y no debe apagar la cara de una persona.
 */
import home from "../datos/home.json";
import config from "../datos/config.json";
import Icono from "./Icono.astro";
import Foto from "./Foto.astro";

const base = import.meta.env.BASE_URL;
const enlace = (r: string) =>
  r === "whatsapp"
    ? `https://wa.me/${config.whatsapp}`
    : `${base}${r}`.replace(/\/{2,}/g, "/");
const ICONOS = ["", "camion", "receta"];
---

<section class="carrusel" id="carrusel" aria-roledescription="carrusel" aria-label="Destacados">
  <div class="carrusel-pista">
    {home.banners.map((banner, indice) => (
      <article
        class:list={["carrusel-pieza", { activa: indice === 0 }]}
        role="group"
        aria-roledescription="diapositiva"
        aria-label={`${indice + 1} de ${home.banners.length}`}
        aria-hidden={indice !== 0}
      >
        <div class="carrusel-texto">
          <span class="carrusel-etiqueta">{banner.etiqueta}</span>
          {indice === 0 ? <h1>{banner.titulo}</h1> : <h2>{banner.titulo}</h2>}
          <p>{banner.texto}</p>
          <a
            class="boton boton-lima"
            href={enlace(banner.enlace)}
            {...(banner.enlace === "whatsapp" ? { target: "_blank", rel: "noopener" } : {})}
          >
            {banner.enlace === "whatsapp" && <Icono nombre="whatsapp" tamano={18} />}
            {banner.boton}
          </a>
        </div>

        <div class="carrusel-arte" aria-hidden="true">
          <span class="arte-circulo"></span>
          <span class="arte-curva"></span>
          {banner.foto ? null : indice === 0 ? (
            <img
              class="arte-isotipo"
              src={`${base}img/isotipo-xivica.svg`}
              alt=""
              width="210"
              height="210"
              fetchpriority="high"
            />
          ) : (
            <span class="arte-icono"><Icono nombre={ICONOS[indice] || "escudo"} tamano={96} grosor={1.4} /></span>
          )}
        </div>

        {banner.foto && (
          <div class="arte-foto">
            <Foto
              nombre={banner.foto}
              alt={banner.foto_alt}
              sizes="(max-width: 900px) 96px, 300px"
              prioridad={indice === 0}
            />
          </div>
        )}
      </article>
    ))}
  </div>

  <div class="carrusel-puntos" role="tablist" aria-label="Elegir">
    {home.banners.map((banner, indice) => (
      <button
        type="button"
        role="tab"
        class:list={["carrusel-punto", { activo: indice === 0 }]}
        data-ir={indice}
        aria-selected={indice === 0}
        aria-label={banner.etiqueta}
      ></button>
    ))}
  </div>
</section>
