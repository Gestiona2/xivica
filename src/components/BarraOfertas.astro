---
/**
 * Encabezado de las ofertas.
 *
 * Antes llevaba una cuenta regresiva hasta medianoche. Se quito: el manual de
 * marca (cap. 63) pide no competir con mensajes de urgencia, y una cuenta
 * atras que se reinicia cada dia es exactamente eso.
 */
import home from "../datos/home.json";
import Icono from "./Icono.astro";
interface Props { cantidad: number; enlace?: boolean }
const { cantidad, enlace = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="barra-ofertas">
  <span class="barra-ofertas-icono"><Icono nombre="brillo" tamano={20} /></span>
  <div>
    <h2>{home.ofertas.titulo}</h2>
    <p>{cantidad} {home.ofertas.texto}</p>
  </div>
  {enlace && (
    <a class="barra-ofertas-enlace" href={`${base}ofertas`.replace(/\/{2,}/g, "/")}>Ver todas →</a>
  )}
</div>
