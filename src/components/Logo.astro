---
/**
 * El logo, en un solo sitio. Todas las paginas lo usan desde aqui.
 *
 * Isotipo: el archivo maestro aprobado (Manual de Marca v2.0, cap. 17),
 * copiado tal cual en public/img/isotipo-xivica.svg. No se redibuja ni se
 * recolorea: el manual lo prohibe.
 *
 * Nombre: el manual aprueba una "version horizontal" (isotipo + nombre) pero
 * no entrega el archivo del logotipo. Por decision del propietario (17/09/2026),
 * mientras llega el archivo el emblema va dentro de la palabra, como la "o" de
 * "Drogueria": Dr{emblema}gueria Xivica, siempre en tipografia oficial (Manrope).
 * Esta anotado en PENDIENTES.md: cuando llegue el archivo, se reemplaza este bloque.
 *
 * Tamanos minimos del manual (cap. 19): isotipo 32 px, logo completo 120 px.
 */
interface Props {
  alto?: number;          // alto del isotipo en px
  soloIsotipo?: boolean;
  negativo?: boolean;     // nombre en blanco, para fondos oscuros
  clase?: string;
}
const { alto = 44, soloIsotipo = false, negativo = false, clase = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const tamano = Math.max(alto, 32);
---

<span class:list={["logo", { "logo-negativo": negativo }, clase]} role="img" aria-label="Droguería Xivica">
  {soloIsotipo ? (
    <img
      class="logo-isotipo"
      src={`${base}img/isotipo-xivica.svg`}
      alt="Droguería Xivica"
      width={tamano}
      height={tamano}
    />
  ) : (
    <span class="logo-nombre" aria-hidden="true" style={`font-size:${Math.round(tamano * 0.52)}px`}>
      <span class="logo-drogueria">Dr<img
        class="logo-o"
        src={`${base}img/isotipo-xivica.svg`}
        alt=""
        width="24"
        height="24"
      />guería</span>
      <span class="logo-xivica">Xivica</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; flex: none; line-height: 1; }
  /* Area de seguridad del manual (cap. 18): el isotipo no se toca con nada. */
  .logo-isotipo { flex: none; display: block; }
  .logo-nombre {
    display: inline-flex; align-items: baseline; gap: 0.28em;
    font-family: var(--font-display); letter-spacing: -0.01em; white-space: nowrap;
  }
  .logo-drogueria { font-weight: 700; color: var(--verde); letter-spacing: 0.02em; }
  .logo-xivica { font-weight: 800; color: var(--azul); }
  /* El emblema hace de "o": va a tamano de letra, sentado sobre la linea base.
     El inline-block es obligatorio: la base de estilos pone todas las imagenes
     como bloque, y sin esto partiria la palabra en renglones. */
  .logo-o { display: inline-block; height: 0.92em; width: auto; vertical-align: -0.1em; }
  .logo-negativo .logo-drogueria,
  .logo-negativo .logo-xivica { color: #fff; }
</style>
