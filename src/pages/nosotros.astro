---
import Tienda from "../layouts/Tienda.astro";
import datos from "../datos/nosotros.json";
import config from "../datos/config.json";

const falta = (v: string) => v === "PENDIENTE";
---
<Tienda titulo="Nosotros" descripcion={datos.entrada} activa="nosotros">
  <div class="container texto">
    <h1>{datos.titulo}</h1>
    <p class="texto-entrada">{datos.entrada}</p>
    <p class="texto-proposito">{datos.proposito}</p>

    {datos.bloques.map((bloque) => (
      <section>
        <h2>{bloque.titulo}</h2>
        <p>{bloque.texto}</p>
      </section>
    ))}

    <section>
      <h2>Lo que nos guía</h2>
      <ul class="valores">
        {datos.valores.map((v) => <li>{v}</li>)}
      </ul>
    </section>

    <section>
      <h2>Datos legales</h2>
      <ul class="texto-lista">
        <li>Razón social: {config.negocio}</li>
        <li>NIT: {falta(config.legal.nit) ? <mark class="falta">Falta el NIT</mark> : config.legal.nit}</li>
        {config.sedes.map((sede) => (
          <li>Habilitación sanitaria {sede.nombre}: {sede.habilitacion_sanitaria}</li>
        ))}
        <li>Regente de farmacia: no aplica. {config.legal.regente_nota}</li>
      </ul>
    </section>
  </div>
</Tienda>
