---
/**
 * Pedidos enviados antes, para repetirlos de un toque. Tambien viven solo en
 * el navegador: son los pedidos que se enviaron desde este dispositivo.
 */
import Tienda from "../layouts/Tienda.astro";
---
<Tienda titulo="Volver a comprar" descripcion="Repite un pedido anterior en Droguería Xivica." activa="volver">
  <div class="container">
    <header class="catalogo-cabeza">
      <h1>Volver a comprar</h1>
      <p>Los pedidos que enviaste desde este dispositivo.</p>
    </header>
    <div id="listaHistorial"><p class="grilla-vacia">Cargando…</p></div>
  </div>
</Tienda>
