---
/**
 * Portada.
 *
 * El orden responde a como compra la gente: primero la promocion, luego el
 * atajo a su seccion, y enseguida producto con precio. Nada de presentacion
 * corporativa antes de mostrar algo que se pueda comprar.
 */
import Tienda from "../layouts/Tienda.astro";
import BannerCarrusel from "../components/BannerCarrusel.astro";
import RailCategorias from "../components/RailCategorias.astro";
import BarraOfertas from "../components/BarraOfertas.astro";
import GrillaProductos from "../components/GrillaProductos.astro";
import FranjaGarantias from "../components/FranjaGarantias.astro";
import { elegirDestacados } from "../scripts/destacados.js";
import productos from "../datos/productos.json";
import categorias from "../datos/categorias.json";

const base = import.meta.env.BASE_URL;
const enlace = (r: string) => `${base}${r}`.replace(/\/{2,}/g, "/");

const enOferta = productos.filter((p) => p.descuento);

// El orden no es el del archivo: ver src/scripts/destacados.js. Los productos
// que requieren formula medica quedan fuera del escaparate.
const destacadas = elegirDestacados(enOferta, 10);

// Lo ya mostrado no se repite mas abajo: ver el mismo producto dos veces en
// una pantalla hace que el catalogo parezca mas pobre de lo que es.
const yaMostrados = new Set(destacadas.map((p) => p.slug));

const filas = categorias
  .filter((c) => ["medicamentos", "cuidado-personal", "bebe-maternidad"].includes(c.id))
  .map((categoria) => {
    const fila = elegirDestacados(
      productos.filter((p) => p.categoria === categoria.id),
      5,
      { excluir: yaMostrados }
    );
    fila.forEach((p) => yaMostrados.add(p.slug));
    return { ...categoria, productos: fila };
  });
---

<Tienda
  titulo="Droguería Xivica — Medicamentos a domicilio en Bogotá"
  descripcion="407 productos con precio actualizado. Domicilio en 45 a 90 minutos en Bogotá. Pedido por WhatsApp atendido por un regente de farmacia."
  activa="inicio"
>
  <div class="container">
    <BannerCarrusel />
    <RailCategorias />
    <BarraOfertas cantidad={enOferta.length} />

    <section class="seccion">
      <header class="seccion-cabeza">
        <h2>Más vendidos en oferta</h2>
        <a class="seccion-enlace" href={enlace("ofertas")}>Ver las {enOferta.length} ofertas →</a>
      </header>
      <GrillaProductos productos={destacadas} prioritarias={5} />
    </section>

    {filas.map((fila) => (
      <section class="seccion">
        <header class="seccion-cabeza">
          <h2>{fila.nombre}</h2>
          <a class="seccion-enlace" href={enlace(`categoria/${fila.id}`)}>Ver todo →</a>
        </header>
        <GrillaProductos productos={fila.productos} />
      </section>
    ))}

    <FranjaGarantias />
  </div>
</Tienda>
