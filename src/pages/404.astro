---
/**
 * Pagina no encontrada. En una tienda lo util no es disculparse: es dar el
 * buscador y las categorias para que la persona siga comprando.
 */
import Tienda from "../layouts/Tienda.astro";
import categorias from "../datos/categorias.json";
const base = import.meta.env.BASE_URL;
---
<Tienda titulo="Página no encontrada" descripcion="Esta página no existe.">
  <div class="container texto">
    <h1>No encontramos esa página</h1>
    <p class="texto-entrada">
      Puede que el producto ya no esté o que el enlace esté mal escrito. Busca lo que
      necesitas arriba, o entra por categoría:
    </p>
    <ul class="texto-lista">
      {categorias.map((c) => (
        <li><a href={`${base}categoria/${c.id}`.replace(/\/{2,}/g, "/")}>{c.icono} {c.nombre}</a></li>
      ))}
    </ul>
    <a class="boton boton-azul" href={base}>Volver al inicio</a>
  </div>
</Tienda>
