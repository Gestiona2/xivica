---
import Tienda from "../../layouts/Tienda.astro";
import legal from "../../datos/legal.json";
const documento = legal.datos;
const fecha = new Date(legal.actualizado).toLocaleDateString("es-CO", { day: "numeric", month: "long", year: "numeric" });
---
<Tienda titulo={documento.titulo} descripcion={documento.titulo + " de Droguería Xivica."}>
  <div class="container texto texto-legal">
    <h1>{documento.titulo}</h1>
    <p class="texto-fecha">Última actualización: {fecha}</p>
    {documento.entrada && <p class="texto-entrada">{documento.entrada}</p>}
    {documento.secciones.map((seccion) => (
      <section>
        <h2>{seccion.titulo}</h2>
        <p>{seccion.texto}</p>
      </section>
    ))}
  </div>
</Tienda>
